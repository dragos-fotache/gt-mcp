{
  "task": "T21-S1",
  "status": "future edit dispositions only; no source/test changes in S1",
  "coverageRoots": ["src", "test", "companion/src", "experiments/t02", "packaging", "scripts"],
  "extraPaths": [
    "package.json",
    "package-lock.json",
    "tsconfig.json",
    "companion/tsconfig.json",
    "vitest.config.ts"
  ],
  "groups": {
    "retain": {
      "disposition": "retain",
      "slice": "regressions as relevant",
      "reason": "Unchanged retained behavior or inert scaffolding; no removal authorization."
    },
    "historical": {
      "disposition": "preserve historical",
      "slice": "none",
      "reason": "Parked T02/companion experiment and fixtures remain intact; not current acceptance."
    },
    "creation": {
      "disposition": "adapt",
      "slice": "S2",
      "reason": "Invocation-local creation, no operationId/receipt/durable recovery; retain domain and error oracles."
    },
    "journal": {
      "disposition": "remove",
      "slice": "S4",
      "reason": "Creation journal/admission/digest/receipt/reservation requirement retired; remove production after consumers detach in S2."
    },
    "old-history": {
      "disposition": "remove",
      "slice": "S2",
      "reason": "Persistent-journal history helper has no successor role."
    },
    "storage": {
      "disposition": "adapt",
      "slice": "S3",
      "reason": "Single authenticated credential record, same key/privacy/ownership boundaries, no anchor/ext4 gate."
    },
    "storage-api": {
      "disposition": "remove",
      "slice": "S4",
      "reason": "Legacy resume/removal/reconciled-provision factories replaced by new profile API."
    },
    "lifecycle": {
      "disposition": "adapt",
      "slice": "S4",
      "reason": "Version2 config/single-record setup/auth/lifecycle; remove descriptor publication and creation retirement."
    },
    "creation-test": {
      "disposition": "adapt",
      "slice": "S2",
      "reason": "Retain validation/confirmation/failure checks; replace operationId/journal or repeated-result expectations with fresh-call behavior."
    },
    "journal-test": {
      "disposition": "remove",
      "slice": "S4",
      "reason": "Only tests retired creation journal/admission/persistence; no counterpart or replacement campaign."
    },
    "recovery-test": {
      "disposition": "remove",
      "slice": "S2",
      "reason": "Only tests cross-invocation journal continuation/exhaustive recovery; retired contract, retain historical evidence."
    },
    "storage-test": {
      "disposition": "adapt",
      "slice": "S3",
      "reason": "Keep encryption/provider/path/ownership/IO risks; replace multi-store format and ext4-only assertions."
    },
    "anchor-test": {
      "disposition": "remove",
      "slice": "S3",
      "reason": "Independent anchor/stale-restore detection explicitly retired; no replacement rollback test."
    },
    "auth-test": {
      "disposition": "adapt fixture; retain auth oracle",
      "slice": "S4",
      "reason": "Keep exact refresh/session/security behavior; update profile fixture/API/config only, remove creation-state assumptions."
    },
    "integration": {
      "disposition": "adapt",
      "slice": "S5",
      "reason": "Keep real backend/Pi/domain/privacy boundaries; replace persistent creation recovery assertions, not retained authorization."
    },
    "package": {
      "disposition": "adapt",
      "slice": "S6",
      "reason": "New runtime closure/version2 templates/guides; installed fresh profiles and old-format refusal, no creation receipt recovery."
    },
    "fixture": {
      "disposition": "adapt fixture; retain behavior oracle",
      "slice": "S4",
      "reason": "Fixture/config/export assumptions depend on old storage/creation API; retained read/HTTP/foundation behavior is not retired."
    }
  },
