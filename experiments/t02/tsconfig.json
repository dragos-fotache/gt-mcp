{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "companion",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": false,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    // Inherited T01 exception, extended to this isolated experimental config
    // ONLY (coordinator-authorized): skipLibCheck for the 43x TS1543
    // diagnostics in @earendil-works/pi-ai@1.1.0 provider .d.ts files under
    // NodeNext. Root and main companion configs stay fully checked. Revisit
    // on any Pi upgrade.
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["companion/index.ts"]
}
